{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "antipas-frontend",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "antipas-frontend-staging"
    },
    "production": {
      "name": "antipas-frontend-production"
    }
  }
}